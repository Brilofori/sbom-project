# Copy to /etc/systemd/system/sbom-scan.service (with sbom-scan.timer), then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now sbom-scan.timer
# Run once by hand:   sudo systemctl start sbom-scan.service
# Logs:               journalctl -u sbom-scan.service
[Unit]
Description=Container SBOM scan (Trivy -> MongoDB -> Wazuh)
Wants=docker.service network-online.target
After=docker.service network-online.target

[Service]
Type=oneshot
# The user and folder from README "Installing", steps 2 and 3. Change them if yours differ.
User=sbom
WorkingDirectory=/opt/sbom-project
# Settings (MongoDB address, ...) come from the .env file in the repository (README, "All settings").
ExecStart=/usr/bin/python3 -u /opt/sbom-project/scan_all.py
TimeoutStartSec=4h
