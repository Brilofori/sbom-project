# Settings for this machine.
#
# How to use this file:
#   1. Copy it:          cp .env.example .env
#   2. Change the lines you need, below.
#   3. Protect it:       chmod 600 .env      (it can contain passwords)
#
# Lines starting with # are ignored. To use a setting that is switched off, delete the #
# in front of it. Anything you don't set keeps the default shown here.


# MongoDB: where the scan results are stored.
# Leave this as it is if MongoDB runs on this machine. Otherwise give its address:
#   SBOM_MONGO_URI=mongodb://10.0.0.5:27017
# and if it needs a password:
#   SBOM_MONGO_URI=mongodb://user:password@10.0.0.5:27017/?authSource=admin
SBOM_MONGO_URI=mongodb://localhost:27017

# The database to use inside MongoDB. Choose another name if this one is already in use.
SBOM_DB=sweri_sbom


# Registry login.
# Usually not needed: the scanner uses the login saved by "docker login <registry>".
# Set these only if that doesn't work, for example when Docker keeps logins in a
# credential helper. They are used for every registry in registries.json.
# SBOM_REGISTRY_USER=
# SBOM_REGISTRY_PASSWORD=


# Wazuh: the file the alerts are written to. The Wazuh agent reads the same file, so if
# you change this, change <location> in wazuh/agent_localfile_block.xml to match.
# SBOM_WAZUH_LOG=/var/log/sbom/trivy-findings.jsonl
