# Settings for this machine. Copy to .env, change what you need, then: chmod 600 .env
# Anything left out uses its default (README, "Configuration"). One KEY=value per line,
# comments on their own line.

# MongoDB. The default is a MongoDB on this machine with no password.
SBOM_MONGO_URI=mongodb://localhost:27017
SBOM_DB=sweri_sbom

# Where Wazuh events are written. The Wazuh agent's <location> must match.
# SBOM_WAZUH_LOG=/var/log/sbom/trivy-findings.jsonl

# Registry mode only, when Docker's saved login can't be read (e.g. a credential helper).
# SBOM_REGISTRY_USER=
# SBOM_REGISTRY_PASSWORD=
